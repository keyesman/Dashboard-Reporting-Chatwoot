# =====================
# CHATWOOT API
# =====================
CHATWOOT_BASE_URL=https://your-chatwoot.com
CHATWOOT_API_TOKEN=your_api_token_here
CHATWOOT_ACCOUNT_ID=1

# =====================
# DATABASE
# =====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dashboard_report_csicube
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# =====================
# AUTH (JWT)
# =====================
JWT_SECRET_KEY=your_super_secret_key_minimum_32_chars
JWT_EXPIRE_HOURS=8

# =====================
# APP
# =====================
APP_ENV=development
